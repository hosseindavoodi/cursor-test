{
  "extends": "@sana/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@sana/ui/*": ["../../packages/ui/src/*"],
      "@sana/assets/*": ["../../packages/assets/*"],
      "@sana/react-query/*": ["../../packages/react-query/src/*"],
      "@sana/types/*": ["../../packages/types/*"],
      "@sana/utilities/*": ["../../packages/utilities/*"],
      "@sana/constants/*": ["../../packages/constants/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", "next.config.js", ".next/types/**/*.ts", "../client-desktop/middleware.ts"],
  "exclude": ["node_modules"]
}
