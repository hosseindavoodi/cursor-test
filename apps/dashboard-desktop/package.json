{
  "name": "dashboard-desktop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build:prod": "env-cmd -f .env-cmdrc.json -e prod -- next build",
    "build:stage": "env-cmd -f .env-cmdrc.json -e stage -- next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@sana/assets": "workspace:*",
    "@sana/constants": "workspace:*",
    "@sana/react-query": "workspace:*",
    "@sana/types": "workspace:*",
    "@sana/ui": "workspace:*",
    "@sana/utilities": "workspace:*",
    "@tailwindcss/postcss": "^4.1.11",
    "axios": "^1.12.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.532.0",
    "moment-jalaali": "^0.10.4",
    "next": "^15.4.2",
    "react": "18",
    "react-dom": "18",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.11",
    "uuid": "^13.0.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.7"
