model Assets {
  id         String    @id() @default(uuid())
  fileName   String
  objectKey  String    @unique
  folderPath String    @unique
  bucketName String
  extension  String?
  type       AssetType @relation(fields: [typeId], references: [id])
  typeId     String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  passenger   Passenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  passengerId String?

  visaPassenger   VisaPassengers? @relation(fields: [visaPassengerId], references: [id], onDelete: SetNull)
  visaPassengerId String?

  visaCountry   VisaCountry? @relation(fields: [visaCountryId], references: [id], onDelete: SetNull)
  visaCountryId String?

  residencyCountry   ResidencyCountry? @relation(fields: [residencyCountryId], references: [id], onDelete: SetNull)
  residencyCountryId String?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([visaPassengerId])
  @@index([passengerId])
  @@index([objectKey])
}

