model AssetType {
  id         String   @id @default(uuid())
  type       String   @unique
  desc       String?
  assets     Assets[]
  deleteable Boolean  @default(true)

  visaCountry   VisaCountry? @relation(fields: [visaCountryId], references: [id])
  visaCountryId String?
}
